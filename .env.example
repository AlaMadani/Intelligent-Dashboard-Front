# =============================================================================
# Dashboard Frontend — Local development environment
# =============================================================================
# ⚠ WARNING: Only public frontend configuration belongs here.
# Never put API keys, database passwords, JWT secrets, or backend
# credentials in this file. Frontend env vars are bundled into
# browser-delivered code and are publicly visible.
# =============================================================================
# Copy this file to .env and fill in your local values:
#   PowerShell: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
# =============================================================================

VITE_API_BASE_URL=http://localhost:8081
VITE_LOGGER_ENDPOINT=http://localhost:5001
VITE_LOGGER_APPLICATION=dashboard-frontend
VITE_GRAFANA_DASHBOARDS_URL=http://localhost:3000/dashboards
VITE_KIBANA_OVERVIEW_URL=http://localhost:5601/app/kibana_overview#/
VITE_I18N_LOCALE=auto
VITE_I18N_FALLBACK_LOCALE=en-US
VITE_AUTH_PANEL_IMAGE_URL=/2.jpg
VITE_SESSION_IDLE_TIMEOUT_MS=900000
